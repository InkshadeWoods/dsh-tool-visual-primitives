# Dependencies
node_modules/

# Lock files
package-lock.json

# npm package archives
*.tgz

# The client entry is loaded directly by DSH. Keep the generated artifact in
# version control so local-folder installs work without an implicit build step.
lib/*
!lib/client.js

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local npm config
.npmrc

# Local credentials and private keys
.env
.env.*
!.env.example
*.pem
*.key
