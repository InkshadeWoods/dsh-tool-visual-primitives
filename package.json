{
  "name": "dsh-tool-visual-primitives",
  "version": "1.0.0",
  "description": "DSH 视觉原语工具：参考 DeepSeek《Thinking with Visual Primitives》论文，将图片路由到外部视觉模型并返回带视觉基元的文本分析。纯文本循环，对话模型无需原生视觉能力即可'看见'图片。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InkshadeWoods/dsh-tool-visual-primitives.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "undici": "^6.21.1"
  },
  "files": [
    "index.mjs",
    "adapters",
    "vision",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "scripts/build.mjs",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "vision",
    "visual-primitives",
    "multimodal"
  ],
  "license": "MIT"
}
